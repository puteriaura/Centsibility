// Firestore security rules for Centsibility app
// Enforce one email per account and restrict access based on role

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles collection stores parent and child profiles
    match /profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Create: enforce unique email across all profiles
      allow create: if request.auth != null && request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@\s]+@[^@\s]+\.[^@\s]+$') &&
        // Ensure no other profile has this email
        !(exists(/databases/$(database)/documents/profiles/$(request.resource.data.email))) &&
        request.resource.data.role == 'commander';

      // Update: allow if the caller owns the doc and email is unchanged or still unique
      allow update: if request.auth != null && request.auth.uid == userId &&
        (request.resource.data.email == resource.data.email ||
         !(exists(/databases/$(database)/documents/profiles/$(request.resource.data.email))));
    }

    // Commander PIN stored under each commander profile
    match /profiles/{userId}/commanderPin/{pinId} {
      allow read, write: if request.auth != null && request.auth.uid == userId &&
        get(/databases/$(database)/documents/profiles/$(userId)).data.role == 'commander';
    }
  }
}
